<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.Master.cs" Inherits="clinica_web.Master" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Clínica</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    <form id="form1" runat="server">
        <nav id="navPrincipal" runat="server" class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" href="~/Default.aspx" runat="server">Clínica</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown"> 
                            <a class="nav-link dropdown-toggle" href="#"
                                role="button" data-bs-toggle="dropdown"
                                aria-expanded="false">Inicio
                            </a>

                             <%-- Opciones del menú desplegable --%>
                            <ul class="dropdown-menu">
                                <li>
                                     <%-- Acceso a la página principal --%>
                                    <a class="dropdown-item" href="~/Default.aspx" runat="server">Página principal
                                    </a>
                                </li>
                                <li>
                                     <%-- Acceso al formulario de inicio de sesión --%>
                                    <a class="dropdown-item" href="~/Login.aspx" runat="server">Iniciar sesión
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="~/Pacientes.aspx" runat="server">Pacientes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="~/Medicos.aspx" runat="server">Médicos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="~/Especialidades.aspx" runat="server">Especialidades</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="~/Turnos.aspx" runat="server">Turnos</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#"
                                role="button" data-bs-toggle="dropdown"
                                aria-expanded="false">Turnos de trabajo
                            </a>

                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="~/TurnosTrabajo.aspx" runat="server">Listado de turnos de trabajo
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="~/FormularioTurnoTrabajo.aspx" runat="server">Agregar turno de trabajo
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#"
                                role="button" data-bs-toggle="dropdown"
                                aria-expanded="false">Usuarios
                            </a>

                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="~/Usuarios.aspx" runat="server">Listado de usuarios
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="~/FormularioUsuario.aspx" runat="server">Nuevo usuario
                                    </a>
                                </li>
                            </ul>
                        </li>
                        
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container">
            <hr />
            <div>
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
